<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- SPA compartido: el proxy de desarrollo y la publicación usan la misma raíz. -->
    <SpaRoot>../WebUI/</SpaRoot>
    <SpaProxyLaunchCommand>pnpm start</SpaProxyLaunchCommand>
    <SpaProxyServerUrl>https://localhost:4200</SpaProxyServerUrl>
  </PropertyGroup>
  <PropertyGroup>
    <!-- La cadena de conexión real vive fuera del repositorio (dotnet user-secrets). -->
    <UserSecretsId>sadactividades-webapi</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.15" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.15" />
    <PackageReference Include="Microsoft.AspNetCore.SpaProxy" Version="10.0.15" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.20.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../Application/Application.csproj" />
    <ProjectReference Include="../../Infrastructure/Infrastructure.csproj" />
    <!-- Solo aporta el ciclo de vida del SPA; no se ensambla al ejecutable.
         Se omite al publicar cuando la compilación del SPA está desactivada: el SDK de JavaScript
         ejecuta $(BuildCommand) en la publicación sin respetar ShouldRunBuildScript. -->
    <ProjectReference Include="../WebUI/WebUI.esproj" Condition="'$(SpaBuildOnPublish)' != 'false'">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
  </ItemGroup>
  <!-- Publicar compila el SPA salvo que se desactive explícitamente con -p:SpaBuildOnPublish=false. -->
  <Target Name="PublishAngular" BeforeTargets="ComputeFilesToPublish" Condition="'$(SpaBuildOnPublish)' != 'false'">
    <Exec Command="pnpm install --frozen-lockfile" WorkingDirectory="$(SpaRoot)" />
    <Exec Command="pnpm build" WorkingDirectory="$(SpaRoot)" />
    <ItemGroup>
      <AngularDist Include="$(SpaRoot)dist/webui/browser/**/*" />
      <ResolvedFileToPublish Include="@(AngularDist->'%(FullPath)')" Exclude="@(ResolvedFileToPublish)" RelativePath="wwwroot/%(RecursiveDir)%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
</Project>
